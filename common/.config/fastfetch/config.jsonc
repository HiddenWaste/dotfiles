{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "pokemon-colorscripts --no-title -rn $(cat ~/.config/fastfetch/cloudy.txt)"
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "magenta"
    }
  },
  "modules": [
    // ==========================================
    // ACTIVE CORE ESSENTIALS
    // ==========================================
    "title",
    "separator",
    "os",
    // "host",
    // "kernel",
    "uptime",
    "packages",
    "shell",
    // "display", // Resolution & Refresh rate
    // "de",
    "wm",
    // "wmtheme",
    // "theme",
    // "icons",
    "terminal",
    //"cpu",
    //"gpu",
    "memory",
    "swap",
    "disk",
    //"colors"

    // ==========================================
    // DISABLED EXPERIMENTAL MODULES
    // (Uncomment lines below to try them out!)
    // ==========================================
    
    // --- Hardware & Power ---
    // "battery",
    // "poweradapter",
    // "cpuusage",
    // "cputemp",
    // "gputemp",
    // "board",        // Motherboard info
    // "bios",
